# 旅行 MCP 服务地址（先启动后端：cd backend && python -m uvicorn app.main:app --port 8000）
TRAVEL_MCP_URL=http://localhost:8000/mcp

# ============ LLM 配置（桥接侧直连大模型，与后端的 LLM 配置互不影响） ============
# 方式一（推荐）：任意 OpenAI 兼容网关 —— DeepSeek / 通义 DashScope / OneAPI 等
#   DeepSeek:  https://api.deepseek.com/v1          模型 deepseek-chat
#   DashScope: https://dashscope.aliyuncs.com/compatible-mode/v1   模型 qwen-plus
PI_LLM_BASE_URL=https://api.deepseek.com/v1
PI_LLM_MODEL=deepseek-chat
PI_LLM_API_KEY=sk-xxx

# 方式二：只填 DEEPSEEK_API_KEY（自动用官方端点 + deepseek-chat）
# DEEPSEEK_API_KEY=sk-xxx

# 方式三：只填 OPENAI_API_KEY（自动用官方端点 + gpt-4o-mini）
# OPENAI_API_KEY=sk-xxx
